{
  "name": "pt-time-block",
  "version": "1.1.1",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Philtonvanguard/pt-timeblock.git"
  },
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"wait-on http://localhost:5173 && electron .\"",
    "vite": "vite",
    "build": "tsc && vite build",
    "icons": "node branding/generate-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "keywords": [],
  "author": {
    "name": "Vipelex LLC",
    "email": "vipelex01@gmail.com"
  },
  "description": "PT Time Block Timeline — Your all-in-one productivity, health, and automation desktop app",
  "license": "MIT",
  "build": {
    "appId": "com.pt.timeblock.timeline",
    "productName": "PT Time Block Timeline",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Productivity",
      "icon": "build/icon.png",
      "maintainer": "Vipelex LLC <vipelex01@gmail.com>",
      "artifactName": "PT-Time-Block-Timeline.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "PT-Time-Block-Timeline.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "PT-Time-Block-Timeline-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PT Time Block Timeline"
    },
    "publish": null
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "electron-store": "^11.0.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "node-cron": "^4.6.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
